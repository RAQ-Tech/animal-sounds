<?xml version="1.0"?>
<Container version="2">
  <Name>Animal-Sounds</Name>
  <Repository>ghcr.io/raq-tech/animal-sounds:latest</Repository>
  <Registry>https://github.com/RAQ-Tech/animal-sounds/pkgs/container/animal-sounds</Registry>
  <Network>bridge</Network>
  <MyIP/>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/RAQ-Tech/animal-sounds/issues</Support>
  <Project>https://github.com/RAQ-Tech/animal-sounds</Project>
  <Overview>Offline-friendly animal picture and sound WebUI. Internal app port is fixed at 3000. /config remains the primary persistent appdata path for future settings.</Overview>
  <Category>MediaApp:Other Kids:Education</Category>
  <WebUI>http://[IP]:[PORT:1]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/RAQ-Tech/animal-sounds/main/unraid/template.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/RAQ-Tech/animal-sounds/main/unraid/animal-sounds-icon.png</Icon>

  <Config Name="WebUI Port" Target="3000" Default="8080" Mode="tcp" Description="Host port mapped to container port 3000" Type="Port" Display="always" Required="true" Mask="false">8080</Config>

  <Config Name="App Config (Primary)" Target="/config" Default="/mnt/user/appdata/animal-sounds" Mode="rw" Description="Primary persistent path for future settings/state (map to appdata)" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/animal-sounds</Config>

  <Config Name="APP_NAME" Target="APP_NAME" Default="Animal Sounds" Mode="" Description="Display name in the UI and API responses" Type="Variable" Display="always" Required="false" Mask="false">Animal Sounds</Config>
  <Config Name="APP_ENV" Target="APP_ENV" Default="production" Mode="" Description="Application environment label" Type="Variable" Display="always" Required="false" Mask="false">production</Config>
  <Config Name="LOG_LEVEL" Target="LOG_LEVEL" Default="info" Mode="" Description="Application log level" Type="Variable" Display="always" Required="false" Mask="false">info</Config>
</Container>
